---
// System, Light or Dark for the site. The choice is remembered and applied before the first paint (Base.astro);
// clicks are handled once for the whole document (src/motion/ui.ts).
interface Props { size?: 'bar' | 'menu' }
const { size = 'bar' } = Astro.props;
const opts = [
  { v: 'system', label: 'System', icon: '<rect x="2.5" y="3.5" width="15" height="10" rx="1.6"/><path d="M7 16.5h6M10 13.5v3"/>' },
  { v: 'light', label: 'Light', icon: '<circle cx="10" cy="10" r="3.2"/><path d="M10 2.5v1.8M10 15.7v1.8M2.5 10h1.8M15.7 10h1.8M4.7 4.7l1.3 1.3M14 14l1.3 1.3M4.7 15.3 6 14M14 6l1.3-1.3"/>' },
  { v: 'dark', label: 'Dark', icon: '<path d="M16 12.3A6.5 6.5 0 0 1 7.7 4a6.5 6.5 0 1 0 8.3 8.3Z"/>' },
];
---
<div class:list={['theme', `theme--${size}`]} role="group" aria-label="Theme">
  {opts.map((o) => (
    <button type="button" class="theme__opt" data-theme-set={o.v} aria-pressed={o.v === 'system' ? 'true' : 'false'} title={`${o.label} theme`}>
      <svg viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={o.icon} />
      <span class:list={[size === 'bar' && 'sr-only']}>{o.label}</span>
    </button>
  ))}
</div>
