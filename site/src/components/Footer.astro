---
import { to } from '../data/url';
import { links, site } from '../data/site';
const year = 2026;
---
<footer class="foot">
  <div class="grid foot__top">
    <p class="foot__say">Touch the notch.<br /><span>Your phone does the <em>rest.</em></span></p>
    <nav aria-label="Footer">
      <ul>
        <li><a class="link" href={to('/')}>Tap to send</a></li>
        <li><a class="link" href={to('/how-it-works/')}>How it works</a></li>
        <li><a class="link" href={to('/get-started/')}>Install guide</a></li>
        <li><a class="link" href={to('/#film')}>The film</a></li>
        <li><a class="link" href={links.repo}>GitHub</a></li>
        <li><a class="link" href={links.license}>License (MIT)</a></li>
      </ul>
    </nav>
    <div class="foot__facts">
      <p>Free and open source under the MIT License.</p>
      <p>No accounts, no cloud and no tracking, ever.</p>
      <p>Any Android phone from Android 13 on, and notched Macs on Apple silicon from macOS 15.</p>
    </div>
  </div>
  <span class="foot__mark" aria-hidden="true">Tap<i>Drop</i></span>
  <div class="foot__base">
    <span>TapDrop {site.version}, {year}. <a class="link" href={links.repo}>Source on GitHub</a>.</span>
    <span>Set in Instrument Serif, Geist and Geist Mono.</span>
  </div>
</footer>
