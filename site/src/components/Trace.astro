---
// "What the notch sees": the light key as the apps draw it. Room, covered, the white rise, the black fall, sent.
// Drawn by src/motion/trace.ts as you scroll (static and complete without motion).
interface Props { id?: string; caption?: boolean }
const { id = 'trace', caption = true } = Astro.props;
const line = 'M0 150 L36 148 L72 151 L108 149 L124 150 L136 160 L146 204 L160 208 L200 207 L212 205 L220 120 L228 40 L242 33 L300 30 L310 33 L318 120 L326 212 L340 216 L372 215 L384 212 L396 160 L406 151 L440 149 L480 151 L520 149 L560 150 L600 149 L640 150';
---
<figure class="trace" data-trace id={id}>
  <div class="trace__head">
    <p class="trace__title">What the notch sees</p>
    <span class="trace__live mono"><span data-trace-lux>112</span> lux</span>
  </div>
  <svg viewBox="0 0 640 260" role="img" aria-label="Light at the notch over one tap: steady room light, a dip as the phone covers the notch, a sharp rise past the needed level when the screen turns white, a fall below the room when it turns black, then back to the room as the phone sends.">
    <defs>
      <linearGradient id={`${id}-tracegrad`} x1="0" x2="1" y1="0" y2="0">
        <stop offset="0" stop-color="#409EFF" /><stop offset="0.5" stop-color="#8561FF" /><stop offset="1" stop-color="#F26BD9" />
      </linearGradient>
      <linearGradient id={`${id}-areagrad`} x1="0" x2="0" y1="0" y2="1">
        <stop offset="0" stop-color="#8561FF" stop-opacity="0.32" /><stop offset="1" stop-color="#8561FF" stop-opacity="0" />
      </linearGradient>
      <clipPath id={`${id}-clip`}><rect data-trace-clip x="0" y="0" width="640" height="260" /></clipPath>
    </defs>
    <line class="t-room" x1="0" y1="150" x2="640" y2="150" />
    <text class="t-label" x="0" y="140">Room</text>
    <line class="t-need" x1="0" y1="88" x2="640" y2="88" />
    <text class="t-label" x="640" y="78" text-anchor="end">Needed</text>
    <g clip-path={`url(#${id}-clip)`}>
      <path class="t-area" d={`${line} L640 260 L0 260 Z`} fill={`url(#${id}-areagrad)`} />
      <path class="t-line" d={line} stroke={`url(#${id}-tracegrad)`} data-trace-line />
    </g>
    <circle class="t-dot" r="5" cx="640" cy="150" data-trace-dot />
    <g class="t-mark" data-mark="1" transform="translate(176 236)"><circle r="12" fill="#5b5d70" /><path d="M-4.5 -1.5 L0 3 L4.5 -1.5" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></g>
    <g class="t-mark" data-mark="2" transform="translate(264 14)"><circle r="12" fill="#2ED17A" /><path d="M-5 0 L-1.5 3.5 L5 -3.5" fill="none" stroke="#06210f" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></g>
    <g class="t-mark" data-mark="3" transform="translate(352 238)"><circle r="12" fill="#2ED17A" /><path d="M-5 0 L-1.5 3.5 L5 -3.5" fill="none" stroke="#06210f" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></g>
    <g class="t-mark" data-mark="4" transform="translate(420 122)"><circle r="12" fill="#409EFF" /><path d="M0 5 V-5 M-4 -1 L0 -5 L4 -1" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></g>
  </svg>
  {caption && (
    <figcaption class="trace__legend">
      <span><i style="background:#5b5d70"></i>Covered</span>
      <span><i style="background:#2ED17A"></i>Light seen, then dark on cue</span>
      <span><i style="background:#409EFF"></i>Sent</span>
      <span><i style="background:transparent;border:1px dashed rgb(46 209 122 / .8)"></i>Needed: your phone’s own light</span>
    </figcaption>
  )}
</figure>
