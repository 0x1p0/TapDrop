---
import { to } from '../data/url';
import { ClientRouter } from 'astro:transitions';
import { site } from '../data/site';
import MenuBar from '../components/MenuBar.astro';
import Footer from '../components/Footer.astro';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/site.css';
import '../styles/sends.css';
import '../styles/originals.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  page?: 'home' | 'how' | 'start' | 'lost';
}
const { title, description = site.description, image = '/og.png', page = 'home' } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogImage = new URL(to(image), Astro.site ?? site.url).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: site.name,
  softwareVersion: site.release,
  description: site.description,
  url: site.url,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Android 13 or newer; macOS 15 or newer on Apple silicon',
  image: ogImage,
  isAccessibleForFree: true,
  license: 'https://opensource.org/licenses/MIT',
  downloadUrl: 'https://github.com/0x1p0/TapDrop/releases/latest',
  sameAs: ['https://github.com/0x1p0/TapDrop'],
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---
<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#08080a" />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" href={to('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={to('/favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={to('/apple-touch-icon.png')} />
    <link rel="sitemap" href={to('/sitemap-index.xml')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="TapDrop: an Android phone pressed to a MacBook's notch, its light spilling around the edges" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="preload" href={to('/fonts/instrument-serif-400-normal.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={to('/fonts/instrument-serif-400-italic.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={to('/fonts/geist-100_900-normal.woff2')} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
    <script is:inline>
      document.documentElement.classList.add('js');
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
      // The theme, before the first paint: System (default), Light or Dark, remembered. Page swaps replace <html>'s
      // attributes, so it is applied again after every swap.
      (function () {
        var KEY = 'tapdrop-theme';
        var sys = matchMedia('(prefers-color-scheme: light)');
        var read = function () { try { var v = localStorage.getItem(KEY); return v === 'light' || v === 'dark' ? v : 'system'; } catch (e) { return 'system'; } };
        var apply = function (pref) {
          pref = pref || read();
          var theme = pref === 'system' ? (sys.matches ? 'light' : 'dark') : pref;
          var h = document.documentElement;
          h.dataset.theme = theme;
          h.dataset.themePref = pref;
          var m = document.querySelector('meta[name="theme-color"]');
          if (m) m.setAttribute('content', theme === 'light' ? '#efede7' : '#08080a');
          document.querySelectorAll('[data-theme-set]').forEach(function (b) { b.setAttribute('aria-pressed', String(b.getAttribute('data-theme-set') === pref)); });
        };
        window.__tdTheme = {
          get: read,
          set: function (pref) { try { if (pref === 'system') localStorage.removeItem(KEY); else localStorage.setItem(KEY, pref); } catch (e) {} apply(pref); document.dispatchEvent(new CustomEvent('td:theme')); },
          apply: apply,
        };
        apply();
        sys.addEventListener('change', function () { if (read() === 'system') { apply(); document.dispatchEvent(new CustomEvent('td:theme')); } });
        document.addEventListener('astro:after-swap', function () { apply(); });
        document.addEventListener('astro:page-load', function () { apply(); });
      })();
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body data-page={page}>
    <a class="skip-link" href="#main">Skip to content</a>
    <div id="curtain" transition:persist="curtain" aria-hidden="true"><div class="curtain__white"></div><div class="curtain__panel"></div></div>
    <MenuBar page={page} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import { start } from '../engine/astro';
      import { setupMotion } from '../motion/setup';
      start(setupMotion);
    </script>
  </body>
</html>
